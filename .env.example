# Copy to .env and choose how the agent decides.
# Without a key (as below) the agent runs in REPLAY mode: it repeats the tool calls a real LLM made for the
# same failures in recorded live runs (recordings/decisions.json); everything else runs for real.

LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_API_KEY=

# Other providers supported by IRIS AI Hub (set all three):
# LLM_PROVIDER=gemini      LLM_MODEL=gemini-2.5-flash   (the free tier allows 20 requests a day: use "Quick demo")
# LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-5-5
# LLM_PROVIDER=openai      LLM_MODEL=<an OpenAI chat model>

# Optional: prices per million tokens, to show an estimated cost on the dashboard.
# LLM_PRICE_INPUT_PER_MTOK=0.10
# LLM_PRICE_OUTPUT_PER_MTOK=0.40

# Base image, only if `docker images` shows the AI Hub build 154 image under another name:
# IRIS_IMAGE=iris-community:2026.3.0AI.154.0
